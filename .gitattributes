# Governance documents are SHA-256 hash-anchored (the published hash is over LF
# bytes). core.autocrlf=true would otherwise rewrite them to CRLF on checkout and
# break both the runtime hash-check and the OpenTimestamps proof. Pin to LF.
governance/**/*.md  text eol=lf
# OpenTimestamps receipts are binary — never apply EOL/text conversion.
governance/**/*.ots binary
*.ots               binary
# Eval harness: the cad/ copy is the exact instrument the concordance ran against,
# and the runners read these byte-for-byte. Pin to LF so checkout normalization
# can't change content (and thus reproducibility) across platforms.
eval/**/*.md        text eol=lf
eval/**/*.json      text eol=lf
eval/**/*.jsonl     text eol=lf
eval/**/*.py        text eol=lf
eval/**/*.mjs       text eol=lf
